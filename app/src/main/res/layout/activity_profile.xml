<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil Utilizator"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nume de familie"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prenume"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etDOB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data Nașterii (Apasă aici)"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvCalculatedAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vârsta: -- ani"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="15dp"/>

        <RadioGroup
            android:id="@+id/rgSex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"/>
            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"/>
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <EditText
                android:id="@+id/etHeight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="Înălțime (cm)"/>
            <EditText
                android:id="@+id/etWeight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="Greutate (kg)"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nivel Activitate:"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerActivity"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Obiectiv:"
            android:textStyle="bold"/>
        <RadioGroup
            android:id="@+id/rgGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <RadioButton
                android:id="@+id/rbLoseWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slăbire"/>
            <RadioButton
                android:id="@+id/rbMaintain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menținere"/>
            <RadioButton
                android:id="@+id/rbGainMuscle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Creștere Musculară"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Creează Cont"
            android:backgroundTint="#4CAF50"
            android:visibility="visible"/>

        <Button
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ȘTERGE CONTUL (RESET)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>